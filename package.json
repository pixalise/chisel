{
  "name": "chisel",
  "productName": "Chisel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.4",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "build": "bun run typecheck && bun scripts/clean.mjs && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "css:check": "bun scripts/check-no-custom-css.mjs",
    "filenames:check": "bun scripts/check-file-names.mjs",
    "react-keys:check": "bun scripts/check-no-slug-react-keys.mjs",
    "terrain-components:check": "bun scripts/check-terrain-component-files.mjs",
    "test": "vitest run src",
    "check": "bun scripts/check.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-accordion": "^1.2.14",
