    "input-otp": "^1.4.2",
    "lodash": "^4.18.1",
    "lucide-react": "^1.21.0",
    "nanoid": "^5.1.15",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.80.0",
    "react-resizable-panels": "^2.1.7",
